{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": 1,
  "build_image": {
    "image": "ghcr.io/atrinik/linux-build@sha256:1231b39d40161c1199fd3e45e99e3d826dde02dade79729c030cc0ce3710898f",
    "source_repository": "atrinik/devcontainer",
    "source_commit": "66b8508434044ca50822558172c5cef47a888762",
    "release": "1.2.0",
    "platform": "linux/amd64"
  },
  "duration_tolerance_seconds": 2.5,
  "quality_budget": {
    "sample_rate": 48000,
    "sample_format": "signed 16-bit PCM intermediate",
    "stereo_music_bitrate_kbps": 160,
    "mono_bitrate_kbps": 80,
    "rate_control": "VBR",
    "encoder_complexity": 10,
    "clipping_allowed": false,
    "clipped_render_peak_target_dbfs": -2.0,
    "clipped_render_policy": "deterministically attenuate only full-scale rendered PCM before encoding",
    "nonzero_pcm_required": true,
    "vorbis_generation": "second lossy generation; each output requires quality review"
  },
  "instrument_bank": {
    "name": "FreePats General MIDI",
    "version": "20060219",
    "installed_config": "/opt/atrinik-freepats.cfg",
    "debian_source": {
      "url": "https://deb.debian.org/debian/pool/main/f/freepats/freepats_20060219.orig.tar.gz",
      "sha256": "70bf8ca084df3903d6c9de43fe20539fc0a553d95cfba4d525da3fe66fda5f10"
    },
    "upstream_archive_sha256": "0261ea1057b232183fa472432d5cedb0dca33698a5319328cdf193d4b2193c8a",
    "license": "GPL-2.0-or-later WITH FreePats-exception",
    "license_reference": "https://freepats.zenvoid.org/licenses.html",
    "recording_distribution_permission": "The FreePats exception states that mixed output is not by itself covered by the GPL.",
    "transformation_note": "The bank is used unmodified as a renderer input and is not included in sound release archives."
  },
  "tools": {
    "ffmpeg": {
      "purpose": "Vorbis decode, 48 kHz resampling, and independent Opus full decode",
      "package": "ffmpeg=7:8.0.1-3ubuntu2",
      "upstream": {
        "version": "8.0.1",
        "url": "https://ffmpeg.org/releases/ffmpeg-8.0.1.tar.xz",
        "sha256": "05ee0b03119b45c0bdb4df654b96802e909e0a752f72e4fe3794f487229e5a41"
      },
      "version_command": ["ffmpeg", "-version"],
      "version_pattern": "^ffmpeg version 8\\.0\\.1"
    },
    "timidity": {
      "purpose": "MIDI renderer",
      "package": "timidity=2.14.0-8.3ubuntu1",
      "source": "pinned inside the build-image digest",
      "upstream": {
        "version": "2.14.0",
        "url": "https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/timidity/2.14.0-8.3ubuntu1/timidity_2.14.0.orig.tar.bz2",
        "sha256": "f97fb643f049e9c2e5ef5b034ea9eeb582f0175dce37bc5df843cc85090f6476"
      },
      "ubuntu_patch": {
        "url": "https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/timidity/2.14.0-8.3ubuntu1/timidity_2.14.0-8.3ubuntu1.debian.tar.xz",
        "sha256": "eaf54de8b655e093f9dfb2f11c4f780a60547740c2eda609c787a77e2bd906ff"
      },
      "version_command": ["timidity", "--version"],
      "version_pattern": "TiMidity\\+\\+ version 2\\.14\\.0"
    },
    "openmpt123": {
      "purpose": "MOD, S3M, and XM renderer",
      "package": "openmpt123=0.8.4-1",
      "upstream": {
        "version": "0.8.4",
        "url": "https://lib.openmpt.org/files/libopenmpt/src/libopenmpt-0.8.4+release.autotools.tar.gz",
        "sha256": "627f9bf11aacae615a1f2c982c7e88cb21f11b2d6f0267946f7c82c5eae4943b"
      },
      "version_command": ["openmpt123", "--version"],
      "version_pattern": "openmpt123 v0\\.8\\.4"
    },
    "opusenc": {
      "purpose": "Ogg Opus encoder",
      "package": "opus-tools=0.2-1build5",
      "upstream": {
        "version": "0.2",
        "url": "https://archive.mozilla.org/pub/opus/opus-tools-0.2.tar.gz",
        "sha256": "b4e56cb00d3e509acfba9a9b627ffd8273b876b4e2408642259f6da28fa0ff86"
      },
      "version_command": ["opusenc", "--version"],
      "version_pattern": "opusenc opus-tools 0\\.2"
    },
    "opusinfo": {
      "purpose": "Ogg Opus structure and stream validation",
      "package": "opus-tools=0.2-1build5",
      "upstream": {
        "version": "0.2",
        "url": "https://archive.mozilla.org/pub/opus/opus-tools-0.2.tar.gz",
        "sha256": "b4e56cb00d3e509acfba9a9b627ffd8273b876b4e2408642259f6da28fa0ff86"
      },
      "version_command": ["sh", "-c", "test -x /usr/bin/opusinfo && dpkg-query -W -f='opusinfo opus-tools ${Version}\\n' opus-tools"],
      "version_pattern": "^opusinfo opus-tools 0\\.2-1build5$"
    },
    "sdl3_mixer_probe": {
      "purpose": "device-free SDL3_mixer Opus backend full decode",
      "source_path": "tools/audio/sdl3-mixer-runtime-probe.c",
      "source_sha256": "5d5b6f64c076967ebd7d784b39a9448733cc01f156884ba24711429e0f68e887",
      "decoder_library_source_repository": "atrinik/devcontainer",
      "decoder_library_source_commit": "66b8508434044ca50822558172c5cef47a888762",
      "decoded_pcm_safety_bound_bytes": 268435456,
      "version_command": ["atrinik-sound-sdl3-mixer-probe", "--version"],
      "version_pattern": "^atrinik-sound-sdl3-mixer-probe 1$",
      "decode_command": ["atrinik-sound-sdl3-mixer-probe", "{input}"]
    }
  }
}
