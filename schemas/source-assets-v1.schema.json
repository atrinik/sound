{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atrinik.org/schemas/sound/source-assets-v1.schema.json",
  "title": "Atrinik sound source asset manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "source_corpus_sha256", "audio_source_count", "source_size_bytes", "assets"],
  "properties": {
    "$schema": {"const": "../schemas/source-assets-v1.schema.json"},
    "schema_version": {"const": 1},
    "source_corpus_sha256": {"$ref": "#/$defs/sha256"},
    "audio_source_count": {"type": "integer", "minimum": 1},
    "source_size_bytes": {"type": "integer", "minimum": 1},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableInteger": {"type": ["integer", "null"], "minimum": 1},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "logical_path", "source_path", "generated_path", "source", "render", "encode", "transformation_notes", "license", "quality_review"],
      "properties": {
        "id": {"type": "string", "pattern": "^sound:(background|effects)/"},
        "logical_path": {"type": "string", "pattern": "^(background|effects)/(?:[a-z0-9_.-]+/)*[a-z0-9_.-]+\\.(mid|mod|s3m|xm|ogg)$"},
        "source_path": {"type": "string", "pattern": "^(background|effects)/(?:[a-z0-9_.-]+/)*[a-z0-9_.-]+\\.(mid|mod|s3m|xm|ogg)$"}, "generated_path": {"type": "string", "pattern": "^audio/(background|effects)/(?:[a-z0-9_.-]+/)*[a-z0-9_.-]+\\.(mid|mod|s3m|xm|ogg)\\.opus$"},
        "source": {"type": "object", "additionalProperties": false, "required": ["sha256", "codec", "container", "sample_rate", "channels", "duration_seconds"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "codec": {"enum": ["midi", "mod", "s3m", "xm", "vorbis"]}, "container": {"type": "string"}, "sample_rate": {"$ref": "#/$defs/nullableInteger"}, "channels": {"$ref": "#/$defs/nullableInteger"}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0}}},
        "render": {"type": "object", "additionalProperties": false, "required": ["renderer", "recipe", "sample_rate", "channels", "tail_policy", "loop"], "properties": {"renderer": {"enum": ["timidity", "openmpt123", "ffmpeg"]}, "recipe": {"type": "array", "items": {"type": "string"}}, "sample_rate": {"type": "integer", "minimum": 1}, "channels": {"type": "integer", "enum": [1, 2]}, "tail_policy": {"const": "preserve-decoder-eof"}, "loop": {"type": "boolean"}}},
        "encode": {"type": "object", "additionalProperties": false, "required": ["codec", "container", "bitrate_kbps", "mode", "signal", "complexity", "serial", "discard_comments"], "properties": {"codec": {"const": "opus"}, "container": {"const": "ogg"}, "bitrate_kbps": {"type": "integer", "minimum": 1}, "mode": {"const": "vbr"}, "signal": {"enum": ["music", "auto"]}, "complexity": {"type": "integer", "minimum": 0, "maximum": 10}, "serial": {"type": "integer", "minimum": 0}, "discard_comments": {"const": true}}},
        "transformation_notes": {"type": "string", "minLength": 1},
        "license": {"type": "object", "additionalProperties": false, "required": ["status", "notice", "notice_sha256", "notice_reference", "blocking_finding", "spdx_expression", "license_text_path"], "properties": {"status": {"enum": ["allowed", "blocked"]}, "notice": {"type": ["string", "null"]}, "notice_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "notice_reference": {"type": ["string", "null"]}, "blocking_finding": {"type": ["string", "null"]}, "spdx_expression": {"type": ["string", "null"]}, "license_text_path": {"type": ["string", "null"]}}},
        "quality_review": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "not-required"}}},
          {"type": "object", "additionalProperties": false, "required": ["status", "blocking_finding", "source_sha256"], "properties": {"status": {"const": "blocked"}, "blocking_finding": {"type": "string"}, "source_sha256": {"$ref": "#/$defs/sha256"}}},
          {"type": "object", "additionalProperties": false, "required": ["logical_path", "status", "source_sha256", "toolchain_sha256", "output_sha256", "reviewed_by", "reviewed_at", "evidence"], "properties": {"logical_path": {"type": "string"}, "status": {"const": "passed"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "toolchain_sha256": {"$ref": "#/$defs/sha256"}, "output_sha256": {"$ref": "#/$defs/sha256"}, "reviewed_by": {"type": "string"}, "reviewed_at": {"type": "string", "format": "date-time"}, "evidence": {"type": "object", "additionalProperties": false, "required": ["method", "artifact_locator", "artifact_sha256", "notes"], "properties": {"method": {"const": "critical-listening"}, "artifact_locator": {"type": "string"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "notes": {"type": "string", "minLength": 1}}}}}
        ]}
      }
    }
  }
}
