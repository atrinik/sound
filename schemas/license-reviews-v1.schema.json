{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atrinik.org/schemas/sound/license-reviews-v1.schema.json",
  "title": "Atrinik per-asset license reviews v1",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "reviews"],
  "properties": {
    "$schema": {"const": "../schemas/license-reviews-v1.schema.json"}, "schema_version": {"const": 1},
    "reviews": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["logical_path", "source_sha256", "notice_sha256", "spdx_expression", "reviewed_by", "reviewed_at", "evidence"],
      "properties": {
        "logical_path": {"type": "string", "pattern": "^(background|effects)/(?:[a-z0-9][a-z0-9_.-]*/)*[a-z0-9][a-z0-9_.-]*\\.(mid|mod|s3m|xm|ogg)$"},
        "source_sha256": {"$ref": "#/$defs/sha256"}, "notice_sha256": {"$ref": "#/$defs/sha256"}, "spdx_expression": {"type": "string", "minLength": 1},
        "reviewed_by": {"type": "string", "pattern": "^(?!.*--)[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"}, "reviewed_at": {"type": "string", "format": "date-time"},
        "evidence": {"type": "object", "additionalProperties": false, "required": ["locator", "sha256", "notes"], "properties": {"locator": {"type": "string", "pattern": "^evidence/[A-Za-z0-9][A-Za-z0-9_.-]*(?:/[A-Za-z0-9][A-Za-z0-9_.-]*)*$"}, "sha256": {"$ref": "#/$defs/sha256"}, "notes": {"type": "string", "minLength": 1}}}
      }
    }}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
