{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atrinik.org/schemas/sound/runtime-manifest-v1.schema.json",
  "title": "Atrinik sound runtime manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "release_tag", "source_commit", "source_tree", "fixture_only", "source_size_bytes", "runtime_size_bytes", "quality_budget", "tool_versions", "toolchain_sha256", "assets"],
  "properties": {
    "$schema": {"const": "schemas/runtime-manifest-v1.schema.json"},
    "schema_version": {"const": 1},
    "release_tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fixture_only": {"type": "boolean"},
    "source_size_bytes": {"type": "integer", "minimum": 1},
    "runtime_size_bytes": {"type": "integer", "minimum": 1},
    "quality_budget": {"$ref": "#/$defs/qualityBudget"},
    "tool_versions": {"type": "object", "additionalProperties": false, "required": ["ffmpeg", "wildmidi", "openmpt123", "opusenc", "opusinfo", "sdl3_mixer_probe"], "properties": {"ffmpeg": {"type": "string"}, "wildmidi": {"type": "string"}, "openmpt123": {"type": "string"}, "opusenc": {"type": "string"}, "opusinfo": {"type": "string"}, "sdl3_mixer_probe": {"type": "string"}}},
    "toolchain_sha256": {"$ref": "#/$defs/sha256"},
    "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualityBudget": {"type": "object", "additionalProperties": false, "required": ["sample_rate", "sample_format", "stereo_music_bitrate_kbps", "mono_bitrate_kbps", "rate_control", "encoder_complexity", "clipping_allowed", "clipped_render_peak_target_dbfs", "clipped_render_policy", "nonzero_pcm_required", "vorbis_generation"], "properties": {"sample_rate": {"const": 48000}, "sample_format": {"type": "string"}, "stereo_music_bitrate_kbps": {"type": "integer"}, "mono_bitrate_kbps": {"type": "integer"}, "rate_control": {"const": "VBR"}, "encoder_complexity": {"type": "integer"}, "clipping_allowed": {"const": false}, "clipped_render_peak_target_dbfs": {"type": "number"}, "clipped_render_policy": {"type": "string"}, "nonzero_pcm_required": {"const": true}, "vorbis_generation": {"type": "string"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["sha256", "codec", "container", "sample_rate", "channels", "duration_seconds"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "codec": {"enum": ["midi", "mod", "s3m", "xm", "vorbis"]}, "container": {"type": "string"}, "sample_rate": {"type": ["integer", "null"]}, "channels": {"type": ["integer", "null"]}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0}}},
    "render": {"type": "object", "additionalProperties": false, "required": ["renderer", "recipe", "sample_rate", "channels", "tail_policy", "loop"], "properties": {"renderer": {"enum": ["wildmidi", "openmpt123", "ffmpeg"]}, "recipe": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "sample_rate": {"const": 48000}, "channels": {"enum": [1, 2]}, "tail_policy": {"const": "preserve-decoder-eof"}, "loop": {"type": "boolean"}}},
    "encode": {"type": "object", "additionalProperties": false, "required": ["codec", "container", "bitrate_kbps", "mode", "signal", "complexity", "serial", "discard_comments"], "properties": {"codec": {"const": "opus"}, "container": {"const": "ogg"}, "bitrate_kbps": {"type": "integer", "minimum": 1}, "mode": {"const": "vbr"}, "signal": {"enum": ["music", "auto"]}, "complexity": {"type": "integer", "minimum": 0, "maximum": 10}, "serial": {"type": "integer", "minimum": 0}, "discard_comments": {"const": true}}},
    "license": {"type": "object", "additionalProperties": false, "required": ["status", "notice", "notice_sha256", "notice_reference", "blocking_finding", "spdx_expression", "license_text_path"], "properties": {"status": {"enum": ["allowed", "blocked"]}, "notice": {"type": ["string", "null"]}, "notice_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "notice_reference": {"type": ["string", "null"]}, "blocking_finding": {"type": ["string", "null"]}, "spdx_expression": {"type": ["string", "null"]}, "license_text_path": {"type": ["string", "null"]}}},
    "qualityReview": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "not-required"}}}, {"type": "object", "additionalProperties": false, "required": ["status", "blocking_finding", "source_sha256"], "properties": {"status": {"const": "blocked"}, "blocking_finding": {"type": "string"}, "source_sha256": {"$ref": "#/$defs/sha256"}}}, {"type": "object", "additionalProperties": false, "required": ["logical_path", "status", "source_sha256", "toolchain_sha256", "output_sha256", "reviewed_by", "reviewed_at", "evidence"], "properties": {"logical_path": {"type": "string"}, "status": {"const": "passed"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "toolchain_sha256": {"$ref": "#/$defs/sha256"}, "output_sha256": {"$ref": "#/$defs/sha256"}, "reviewed_by": {"type": "string"}, "reviewed_at": {"type": "string"}, "evidence": {"type": "object", "additionalProperties": false, "required": ["method", "artifact_locator", "artifact_sha256", "notes"], "properties": {"method": {"const": "critical-listening"}, "artifact_locator": {"type": "string", "pattern": "^evidence/"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "notes": {"type": "string", "minLength": 1}}}}}]},
    "renderedPcm": {"type": "object", "additionalProperties": false, "required": ["sample_rate", "channels", "duration_seconds", "peak", "rms_dbfs", "clipping", "input_peak", "input_clipping", "applied_gain_db"], "properties": {"sample_rate": {"type": "integer"}, "channels": {"enum": [1, 2]}, "duration_seconds": {"type": "number"}, "peak": {"type": "number"}, "rms_dbfs": {"type": "number"}, "clipping": {"type": "boolean"}, "input_peak": {"type": "number"}, "input_clipping": {"type": "boolean"}, "applied_gain_db": {"type": "number"}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["sha256", "size_bytes", "codec", "container", "channels", "sample_rate", "duration_seconds", "peak", "rms_dbfs", "clipping", "rendered_pcm"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1}, "codec": {"const": "opus"}, "container": {"const": "ogg"}, "channels": {"enum": [1, 2]}, "sample_rate": {"const": 48000}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0}, "peak": {"type": "number", "minimum": 0, "maximum": 1}, "rms_dbfs": {"type": "number"}, "clipping": {"const": false}, "rendered_pcm": {"$ref": "#/$defs/renderedPcm"}}},
    "asset": {"type": "object", "additionalProperties": false, "required": ["id", "logical_path", "source_path", "generated_path", "source", "render", "encode", "transformation_notes", "license", "quality_review", "output"], "properties": {"id": {"type": "string", "pattern": "^sound:(background|effects)/(?:[a-z0-9][a-z0-9_.-]*/)*[a-z0-9][a-z0-9_.-]*\\.(mid|mod|s3m|xm|ogg)$"}, "logical_path": {"type": "string", "pattern": "^(background|effects)/(?:[a-z0-9][a-z0-9_.-]*/)*[a-z0-9][a-z0-9_.-]*\\.(mid|mod|s3m|xm|ogg)$"}, "source_path": {"type": "string", "pattern": "^(background|effects)/(?:[a-z0-9][a-z0-9_.-]*/)*[a-z0-9][a-z0-9_.-]*\\.(mid|mod|s3m|xm|ogg)$"}, "generated_path": {"type": "string", "pattern": "^audio/(background|effects)/(?:[a-z0-9][a-z0-9_.-]*/)*[a-z0-9][a-z0-9_.-]*\\.(mid|mod|s3m|xm|ogg)\\.opus$"}, "source": {"$ref": "#/$defs/source"}, "render": {"$ref": "#/$defs/render"}, "encode": {"$ref": "#/$defs/encode"}, "transformation_notes": {"type": "string", "minLength": 1}, "license": {"$ref": "#/$defs/license"}, "quality_review": {"$ref": "#/$defs/qualityReview"}, "output": {"$ref": "#/$defs/output"}}}
  }
}
