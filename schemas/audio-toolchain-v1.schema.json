{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atrinik.org/schemas/sound/audio-toolchain-v1.schema.json",
  "title": "Atrinik sound audio toolchain v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "apt_snapshot", "build_image", "duration_tolerance_seconds", "quality_budget", "instrument_bank", "license_texts", "runtime_libraries", "tools"],
  "properties": {
    "$schema": {"const": "../schemas/audio-toolchain-v1.schema.json"},
    "schema_version": {"const": 1},
    "apt_snapshot": {"type": "string", "pattern": "^https://snapshot\\.ubuntu\\.com/ubuntu/[0-9]{8}T[0-9]{6}Z$"},
    "build_image": {"type": "object", "additionalProperties": false, "required": ["image", "source_repository", "source_commit", "release", "platform"], "properties": {"image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"}, "source_repository": {"const": "atrinik/devcontainer"}, "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "release": {"type": "string"}, "platform": {"const": "linux/amd64"}}},
    "duration_tolerance_seconds": {"type": "number", "exclusiveMinimum": 0},
    "quality_budget": {"type": "object", "additionalProperties": false, "required": ["sample_rate", "sample_format", "stereo_music_bitrate_kbps", "mono_bitrate_kbps", "rate_control", "encoder_complexity", "clipping_allowed", "clipped_render_peak_target_dbfs", "clipped_render_policy", "nonzero_pcm_required", "vorbis_generation"], "properties": {"sample_rate": {"const": 48000}, "sample_format": {"type": "string"}, "stereo_music_bitrate_kbps": {"type": "integer", "minimum": 1}, "mono_bitrate_kbps": {"type": "integer", "minimum": 1}, "rate_control": {"const": "VBR"}, "encoder_complexity": {"type": "integer", "minimum": 0, "maximum": 10}, "clipping_allowed": {"const": false}, "clipped_render_peak_target_dbfs": {"type": "number", "maximum": 0}, "clipped_render_policy": {"type": "string"}, "nonzero_pcm_required": {"const": true}, "vorbis_generation": {"type": "string"}}},
    "instrument_bank": {"type": "object", "additionalProperties": false, "required": ["name", "version", "installed_config", "installed_config_sha256", "installed_tree", "installed_tree_sha256", "debian_source", "upstream_archive_sha256", "license", "license_reference", "recording_distribution_permission", "transformation_note"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "installed_config": {"type": "string"}, "installed_config_sha256": {"$ref": "#/$defs/sha256"}, "installed_tree": {"type": "string"}, "installed_tree_sha256": {"$ref": "#/$defs/sha256"}, "debian_source": {"$ref": "#/$defs/download"}, "upstream_archive_sha256": {"$ref": "#/$defs/sha256"}, "license": {"type": "string"}, "license_reference": {"type": "string"}, "recording_distribution_permission": {"type": "string"}, "transformation_note": {"type": "string"}}},
    "license_texts": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["installed_path", "archive_path", "source_url", "sha256"], "properties": {"installed_path": {"type": "string"}, "archive_path": {"type": "string"}, "source_url": {"type": "string", "format": "uri"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "runtime_libraries": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "tools": {"type": "object", "required": ["ffmpeg", "timidity", "openmpt123", "opusenc", "opusinfo", "sdl3_mixer_probe"], "additionalProperties": false, "properties": {"ffmpeg": {"$ref": "#/$defs/tool"}, "timidity": {"$ref": "#/$defs/tool"}, "openmpt123": {"$ref": "#/$defs/tool"}, "opusenc": {"$ref": "#/$defs/tool"}, "opusinfo": {"$ref": "#/$defs/tool"}, "sdl3_mixer_probe": {"$ref": "#/$defs/probe"}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "download": {"type": "object", "additionalProperties": false, "required": ["url", "sha256"], "properties": {"url": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "upstream": {"type": "object", "additionalProperties": false, "required": ["version", "url", "sha256"], "properties": {"version": {"type": "string"}, "url": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "tool": {"type": "object", "required": ["purpose", "package", "installed_path", "installed_sha256", "upstream", "version_command", "version_pattern"], "additionalProperties": false, "properties": {"purpose": {"type": "string"}, "package": {"type": "string"}, "installed_path": {"type": "string"}, "installed_sha256": {"$ref": "#/$defs/sha256"}, "source": {"type": "string"}, "upstream": {"$ref": "#/$defs/upstream"}, "ubuntu_patch": {"$ref": "#/$defs/download"}, "version_command": {"type": "array", "items": {"type": "string"}}, "version_pattern": {"type": "string"}}},
    "probe": {"type": "object", "additionalProperties": false, "required": ["purpose", "source_path", "source_sha256", "installed_path", "installed_sha256", "decoder_library_source_repository", "decoder_library_source_commit", "decoded_pcm_safety_bound_bytes", "version_command", "version_pattern", "decode_command"], "properties": {"purpose": {"type": "string"}, "source_path": {"type": "string"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "installed_path": {"type": "string"}, "installed_sha256": {"$ref": "#/$defs/sha256"}, "decoder_library_source_repository": {"type": "string"}, "decoder_library_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "decoded_pcm_safety_bound_bytes": {"type": "integer", "minimum": 1}, "version_command": {"type": "array", "items": {"type": "string"}}, "version_pattern": {"type": "string"}, "decode_command": {"type": "array", "items": {"type": "string"}}}}
  }
}
